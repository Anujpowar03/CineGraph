# Base URL of the CineGraph API.
# Leave as /api during development: Vite proxies /api to http://localhost:5000
# (see vite.config.js), so the session cookie stays same-origin.
# Only set a full URL (e.g. https://api.example.com/api) for a separate deployment.
# NEVER put secrets here - every VITE_ variable is visible in the browser bundle.
VITE_API_URL=/api
