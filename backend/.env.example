# ---------------------------------------------------------------
# CineGraph backend configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit .env - it is listed in .gitignore.
# ---------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000

# Comma-separated list of front-end origins allowed by CORS
CLIENT_URL=http://localhost:5173

# --- Neo4j ------------------------------------------------------
# Local Neo4j Desktop / Docker / server:   neo4j://localhost:7687  (or bolt://localhost:7687)
# Neo4j AuraDB (TLS is mandatory):         neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-your-neo4j-password
# Local installs and AuraDB Free both use the default database "neo4j"
NEO4J_DATABASE=neo4j

# --- Authentication ---------------------------------------------
# Use a long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
# 'lax' works when the front end is served through the Vite proxy (same site).
# Use 'none' (requires HTTPS) only if front end and API are on different sites.
COOKIE_SAMESITE=lax

# --- Optional: TMDB poster metadata (npm run tmdb:sync) ----------
# Leave blank to use CineGraph's generated poster artwork.
# Get a free "API Read Access Token" at https://www.themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=
