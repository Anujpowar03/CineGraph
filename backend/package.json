{
  "name": "cinegraph-backend",
  "version": "1.0.0",
  "description": "CineGraph API - graph-based movie recommendations with Neo4j, Express and Cypher",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src src/server.js",
    "db:constraints": "node src/scripts/createConstraints.js",
    "seed": "node src/scripts/seedDatabase.js",
    "seed:reset": "node src/scripts/seedDatabase.js --reset",
    "evaluate": "node src/scripts/evaluateRecommendations.js",
    "tmdb:sync": "node src/scripts/syncTmdbPosters.js",
    "test": "vitest run --config vitest.config.js",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:all": "npm run test && npm run test:integration"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "4.21.2",
    "express-rate-limit": "7.5.1",
    "express-validator": "7.2.1",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.0",
    "neo4j-driver": "5.28.1"
  },
  "devDependencies": {
    "nodemon": "3.1.10",
    "supertest": "7.1.4",
    "vitest": "2.1.9"
  }
}
